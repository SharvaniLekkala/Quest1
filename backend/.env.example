OUTPUT_DIR=outputs
WHISPER_MODEL=small
MATCH_THRESHOLD=82
MAX_VIDEO_HEIGHT=720
# Optional Netscape-format browser cookies for a provider that requires a session.
# Keep the actual file outside Git, for example: COOKIES_FILE=C:\secure\provider-cookies.txt
# COOKIES_FILE=
# Optional: read cookies from a locally installed browser instead of a file.
# Close the browser before starting the API, then set e.g. COOKIES_FROM_BROWSER=chrome
# COOKIES_FROM_BROWSER=
# Optional HTTP/SOCKS proxy for every public-video request. Leave blank to use
# the normal network connection. Do not route browser cookies through an
# untrusted proxy.
# DOWNLOAD_PROXY=
